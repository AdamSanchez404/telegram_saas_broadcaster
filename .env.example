# ==========================================
# Токены и ключи доступа Telegram
# ==========================================
# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# API ID и Hash от https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Telethon StringSession (строка авторизации для работы в облаке без диска)
# Получите ее командой: python generate_string_session.py
STRING_SESSION=

# ==========================================
# AI Helper (Опционально)
# ==========================================
# Google Gemini API Key
GEMINI_API_KEY=

# ==========================================
# Настройки безопасных пауз и антиспама
# ==========================================
# Минимальная и максимальная пауза между отправкой в разные группы (в секундах)
MIN_DELAY_BETWEEN_CHATS_SEC=25.0
MAX_DELAY_BETWEEN_CHATS_SEC=60.0

# Интервал повтора цикла рассылки по умолчанию (в минутах)
DEFAULT_INTERVAL_MINUTES=30

# Пакетная пауза: каждые N чатов делается расширенная пауза в M секунд
BATCH_SIZE=10
BATCH_PAUSE_SEC=120.0
